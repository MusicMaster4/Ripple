# Public Convex URLs. These are identifiers, never administrative credentials.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
# Local CLI deployment selection (not needed by the browser).
CONVEX_DEPLOYMENT=dev:your-deployment
# Set BETTER_AUTH_SECRET and SITE_URL directly in Convex, never in VITE_*.
